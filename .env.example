# Server
PORT=5000
FRONTEND_URL=http://localhost:3000

# Supabase (Project Settings -> API)
# Use the service role / secret key on the server only. Never expose it to the client.
SUPABASE_URL=your-supabase-project-url
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Required for the Next.js server-side proxy to call /api/admin.
# Generate a random secret and use the same value in the frontend's server env.
ADMIN_API_PROXY_SECRET=

# Required by the Next.js server-side contact form proxy.
CONTACT_API_PROXY_SECRET=

# Password reset email delivery through Resend.
RESEND_API_KEY=
ADMIN_RESET_FROM_EMAIL="The Shrub Lodge <onboarding@resend.dev>"

# Used only by `npm run create-admin`; do not commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
